{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Followers",
        "Subscribers",
        "Views",
        "Engagement",
        "Revenue",
        "Posts",
        "Posting consistency",
        "Custom"
      ]
    },
    "target": {
      "type": "number",
      "title": "Target",
      "default": 0
    },
    "current_value": {
      "type": "number",
      "title": "Current Value",
      "default": 0
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "platform": {
      "type": "string",
      "title": "Platform"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "On Track",
        "Behind",
        "At Risk",
        "Completed",
        "Not Started"
      ],
      "default": "Not Started"
    }
  },
  "required": [
    "name",
    "type",
    "target"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
