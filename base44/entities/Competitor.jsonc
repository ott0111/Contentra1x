{
  "name": "Competitor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "username": {
      "type": "string",
      "title": "Username"
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "enum": [
        "TikTok",
        "YouTube",
        "Instagram",
        "X",
        "Facebook",
        "LinkedIn",
        "Twitch",
        "Threads"
      ]
    },
    "profile_url": {
      "type": "string",
      "title": "Profile URL"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
