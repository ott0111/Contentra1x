{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "scheduled_post",
        "goal_update",
        "ai_recommendation",
        "performance_milestone",
        "team_assignment",
        "approval_request",
        "content_reminder",
        "system"
      ]
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "body": {
      "type": "string",
      "title": "Body"
    },
    "read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    },
    "link": {
      "type": "string",
      "title": "Link"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
