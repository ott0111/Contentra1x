{
  "name": "Revenue",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "Sponsorships",
        "Ad revenue",
        "Affiliates",
        "Donations",
        "Subscriptions",
        "Merchandise",
        "Other"
      ]
    },
    "platform": {
      "type": "string",
      "title": "Platform"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "campaign": {
      "type": "string",
      "title": "Campaign"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "amount",
    "source"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
