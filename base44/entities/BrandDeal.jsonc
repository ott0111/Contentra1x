{
  "name": "BrandDeal",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "contact": {
      "type": "string",
      "title": "Contact"
    },
    "campaign": {
      "type": "string",
      "title": "Campaign"
    },
    "deal_value": {
      "type": "number",
      "title": "Deal Value",
      "default": 0
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "USD"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "deliverables": {
      "type": "string",
      "title": "Deliverables"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Prospect",
        "Negotiating",
        "Accepted",
        "Creating",
        "Submitted",
        "Approved",
        "Paid",
        "Cancelled"
      ],
      "default": "Prospect"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "payment_status": {
      "type": "string",
      "title": "Payment Status",
      "enum": [
        "Unpaid",
        "Partial",
        "Paid",
        "Overdue"
      ],
      "default": "Unpaid"
    }
  },
  "required": [
    "brand"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
